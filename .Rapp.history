library(tidyverse)#
library(stringr)#
#
# 1) EU27 list (your earlier list is fine)#
EU27 <- c(#
  "AUT","BEL","BGR","CYP","CZE","DEU","DNK","ESP","EST","FIN","FRA","GRC",#
  "HRV","HUN","IRL","ITA","LTU","LUX","LVA","MLT","NLD","POL","PRT","ROU",#
  "SVK","SVN","SWE"#
)#
#
# 2) drop TOT rows early (TOT is not a real exporter)#
wiot_2014 <- wiot %>%#
  filter(Year == 2014, Country != "TOT")#
#
# 3) Identify C24 row-number (RNr) and the importer-use columns for C24#
c24_rnr <- wiot_2014 %>%#
  filter(IndustryCode == "C24") %>%#
  distinct(RNr) %>%#
  pull(RNr)#
#
stopifnot(length(c24_rnr) == 1)#
#
use_cols_c24 <- names(wiot_2014) %>%#
  str_subset(paste0(c24_rnr, "$"))  # columns like DEU15, CHN15, ... for RNr=15#
#
stopifnot(length(use_cols_c24) > 0)#
#
# 4) Build exporter->importer flows for C24#
flows_c24 <- wiot_2014 %>%#
  filter(RNr == c24_rnr) %>%#
  select(Country, all_of(use_cols_c24)) %>%#
  pivot_longer(#
    cols = all_of(use_cols_c24),#
    names_to = "importer_ind",#
    values_to = "value"#
  ) %>%#
  mutate(#
    importer = str_sub(importer_ind, 1, 3),#
    exporter = Country#
  )
flows_c24_clean <- flows_c24 %>%#
  filter(importer != "TOT") %>%   # TOT importer also not real#
  mutate(#
    importer_group = case_when(#
      importer %in% EU27 ~ "EU",#
      importer == "ROW"  ~ "ROW",#
      TRUE               ~ "nonEU"#
    ),#
    exporter_group = case_when(#
      exporter %in% EU27 ~ "EU",#
      exporter == "ROW"  ~ "ROW",#
      TRUE               ~ "nonEU"#
    )#
  )
eu_imports <- flows_c24_clean %>%#
  filter(importer_group == "EU") %>%#
  group_by(exporter_group) %>%#
  summarise(value = sum(value, na.rm = TRUE), .groups = "drop") %>%#
  mutate(share = value / sum(value)) %>%#
  arrange(desc(share))#
#
eu_imports
top_nonEU_exporters <- flows_c24_clean %>%#
  filter(importer_group == "EU", exporter_group == "nonEU") %>%#
  group_by(exporter) %>%#
  summarise(value = sum(value, na.rm = TRUE), .groups="drop") %>%#
  mutate(share = value / sum(value), cum_share = cumsum(share)) %>%#
  arrange(desc(value))#
#
top_nonEU_exporters %>% print(n = 50)
library(tidyverse)#
#
# ----------------------------#
# 0) Paths / inputs#
# ----------------------------#
RAW_DIR  <- "data_raw"#
FILE_OECD <- file.path(RAW_DIR, "2014_OECDIO.csv")
# EU27 list aligned to your WIOD work (no GBR)#
EU27 <- c(#
  "AUT","BEL","BGR","CYP","CZE","DEU","DNK","ESP","EST","FIN","FRA","GRC",#
  "HRV","HUN","IRL","ITA","LTU","LUX","LVA","MLT","NLD","POL","PRT","ROU",#
  "SVK","SVN","SWE"#
)#
#
# ----------------------------#
# 1) Read OECD ICIO CSV#
# ----------------------------#
# This file is huge; readr is fine but may take a bit.#
oecd <- readr::read_csv(FILE_OECD, show_col_types = FALSE)#
#
# First column is the row key (country_industry or special rows like OUT/VA)#
# In your file this was called V1.#
stopifnot("V1" %in% names(oecd))#
#
# ----------------------------#
# 2) Pull the OUT row (gross output by country-industry)#
# ----------------------------#
out_row <- oecd %>% filter(V1 == "OUT")#
stopifnot(nrow(out_row) == 1)#
#
out_long <- out_row %>%#
  pivot_longer(#
    cols = -V1,#
    names_to = "country_industry",#
    values_to = "gross_output"#
  ) %>%#
  select(country_industry, gross_output)#
#
# Split into country + industry.#
# Note: There will be a few columns like "TLS", "VA", "OUT" etc. -> drop later#
out_long <- out_long %>%#
  separate(#
    country_industry,#
    into = c("country", "industry"),#
    sep = "_",#
    extra = "merge",#
    fill = "right"#
  ) %>%#
  filter(!is.na(industry))#
#
# Keep only C24A and C24B#
metals_out <- out_long %>%#
  filter(industry %in% c("C24A", "C24B")) %>%#
  mutate(#
    exporter_group = case_when(#
      country %in% EU27 ~ "EU",#
      country == "ROW" ~ "ROW",#
      TRUE ~ "nonEU"#
    )#
  )#
#
# ----------------------------#
# 3) OECD shares: EU vs nonEU vs ROW for steel/non-ferrous#
# ----------------------------#
shares_by_industry <- metals_out %>%#
  group_by(industry, exporter_group) %>%#
  summarise(value = sum(gross_output, na.rm = TRUE), .groups = "drop") %>%#
  group_by(industry) %>%#
  mutate(share = value / sum(value)) %>%#
  ungroup() %>%#
  arrange(industry, desc(share))#
#
print(shares_by_industry)#
#
# ----------------------------#
# 4) Top named exporters for steel and non-ferrous (exclude EU + ROW)#
# ----------------------------#
top_exporters <- metals_out %>%#
  filter(!country %in% EU27, country != "ROW") %>%#
  group_by(industry, country) %>%#
  summarise(value = sum(gross_output, na.rm = TRUE), .groups = "drop") %>%#
  group_by(industry) %>%#
  mutate(#
    share = value / sum(value),#
    rank = rank(-value, ties.method = "first")#
  ) %>%#
  ungroup() %>%#
  arrange(industry, rank)#
#
print(top_exporters %>% filter(rank <= 20), n = 50)#
#
# ----------------------------#
# 5) Country composition: steel share within basic metals#
# ----------------------------#
composition <- metals_out %>%#
  select(country, industry, gross_output) %>%#
  pivot_wider(names_from = industry, values_from = gross_output, values_fill = 0) %>%#
  mutate(#
    basic_metals = C24A + C24B,#
    steel_share_in_basic_metals = if_else(basic_metals > 0, C24A / basic_metals, NA_real_),#
    nonferrous_share_in_basic_metals = if_else(basic_metals > 0, C24B / basic_metals, NA_real_),#
    exporter_group = case_when(#
      country %in% EU27 ~ "EU",#
      country == "ROW" ~ "ROW",#
      TRUE ~ "nonEU"#
    )#
  ) %>%#
  arrange(desc(basic_metals))#
#
# Example: inspect some countries you care about#
focus <- c("DEU","USA","CHN","TUR","IND","RUS","NOR","GBR","ROW")#
print(composition %>% filter(country %in% focus), n = 100)#
#
# Top producers overall#
print(composition %>% select(country, exporter_group, basic_metals, steel_share_in_basic_metals) %>% head(30), n = 50)#
#
# ----------------------------#
# 6) Save outputs (optional but helpful)#
# ----------------------------#
PROC_DIR <- "data_processed"#
dir.create(PROC_DIR, showWarnings = FALSE)#
#
readr::write_csv(shares_by_industry, file.path(PROC_DIR, "oecd_shares_c24A_c24B_2014.csv"))#
readr::write_csv(top_exporters,      file.path(PROC_DIR, "oecd_top_exporters_c24A_c24B_2014.csv"))#
readr::write_csv(composition,        file.path(PROC_DIR, "oecd_country_composition_c24A_c24B_2014.csv"))#
#
message("Done. Wrote 3 CSVs to data_processed/.")
